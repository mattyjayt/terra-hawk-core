{
 "schema_version": 1,
 "diagram_type": "erd",
 "meta": {
  "title": "TerraHawk Supabase data model v1 \u2014 DRAFT",
  "locale": "en",
  "output": "diagrams/data-model-v1/data-model-v1.html",
  "quality_profile": "standard",
  "views": [
   {
    "id": "topology",
    "label": "Topology hub",
    "focus": [
     "systems",
     "devices",
     "readings",
     "events",
     "commands"
    ],
    "note": "devices is the hub: every telemetry, event and command row points at one device id (MQTT {device_id})."
   },
   {
    "id": "telemetry",
    "label": "Telemetry",
    "focus": [
     "readings",
     "readings_5m",
     "latest",
     "devices"
    ],
    "note": "Raw readings (7\u201314 d) roll up into readings_5m by a scheduled job; latest is a view, not a table."
   },
   {
    "id": "ops",
    "label": "Operations + auth",
    "focus": [
     "events",
     "commands",
     "profiles",
     "user_roles"
    ],
    "note": "commands.issued_by is null for automation; roles operator/viewer/admin live in user_roles."
   },
   {
    "id": "vision",
    "label": "Vision (parked)",
    "focus": [
     "detections",
     "images",
     "systems"
    ],
    "note": "Garden vision is parked: these tables are placeholders, not for v1 migration."
   }
  ]
 },
